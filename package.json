{
  "name": "kidsy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kidsy - learn with fun (KG to Grade 6)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/selftest.mjs",
    "icons": "node scripts/make-icons.mjs",
    "app:sync": "node scripts/build.mjs && npx cap sync",
    "app:android": "npm run app:sync && npx cap open android",
    "app:ios": "npm run app:sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "esbuild": "^0.27.0",
    "sharp": "^0.35.4"
  }
}
